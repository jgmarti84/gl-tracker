# Optional settings for gl-tracker. Copy to .env and fill in only what you need.
# .env is gitignored: never commit it. Nothing loads it automatically; before
# running a script:   set -a; source .env; set +a

# FTP access: only for scripts/fetch_radar_volume.py and scripts/list_volumes.py
# (same SINARAME FTP as gl-radarlib's .env)
FTP_HOST=
FTP_USER=
FTP_PASS=

# Data roots (config.py / h0_wrf.py). Leave unset to use the defaults.
# GRILLA_RAIZ=/home/datos/radar/grillas
# WRFOUT_RAIZ=/home/datos/wrfdatos/wrfout
# TRACKING_OUT=<repo>/out    # where systems-db.sqlite and estado_tracking.pkl are written
